{
  "name": "bill-splitter-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "uploads:cleanup": "node --env-file=.env.local scripts/cleanup-uploads.mjs",
    "test:e2e:uploads": "RUN_SUPABASE_E2E=1 RECEIPT_EXTRACTION_DEV_FIXTURE=success node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/image-uploads.spec.js",
    "test:e2e:phase3": "RUN_SUPABASE_E2E=1 node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/phase-3.spec.js",
    "test:integration:supabase": "RUN_SUPABASE_INTEGRATION=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:integration:gemini": "RUN_GEMINI_INTEGRATION=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/gemini-receipt.integration.test.js",
    "test:e2e:supabase": "npm run test:integration:supabase && RUN_SUPABASE_E2E=1 playwright test tests/e2e/phase-1.spec.js",
    "rate-limits:cleanup": "node --env-file=.env.local scripts/cleanup-rate-limits.mjs",
    "test:integration:rate-limits": "RUN_RATE_LIMIT_INTEGRATION=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/rate-limits.integration.test.js",
    "test:e2e:a11y": "playwright test --config=playwright.accessibility.config.mjs",
    "test:e2e:a11y:live": "RUN_SUPABASE_E2E=1 node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --config=playwright.accessibility.config.mjs",
    "lifecycle:cleanup": "node --env-file=.env.local scripts/cleanup-bill-lifecycle.mjs",
    "test:e2e:lifecycle": "playwright test --config=playwright.lifecycle.config.mjs",
    "icons:generate": "node scripts/generate-brand-icons.mjs",
    "test:e2e:design": "playwright test --config=playwright.design.config.mjs"
  },
  "dependencies": {
    "@animate-ui/react": "^2.3.0",
    "@daypicker/react": "^10.0.2",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-select": "^2.4.1",
    "@sentry/nextjs": "^11.8.0",
    "@supabase/supabase-js": "^2.57.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "motion": "^14.6.0",
    "next": "^16.3.1",
    "radix-ui": "^1.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.13",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
