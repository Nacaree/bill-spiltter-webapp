# Public project coordinates are safe to expose to the browser. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Keep this server-only. Find it in `supabase status` locally or your project API settings.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Use at least 32 random characters outside local development.
PARTICIPANT_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional previous key retained temporarily during signing-key rotation.
PARTICIPANT_SESSION_PREVIOUS_SECRET=

# Free key from https://ocr.space/ocrapi
OCR_SPACE_API_KEY=
# Optional endpoint override; the normal free endpoint is used when blank.
OCR_SPACE_API_URL=
# Development only: success, partial, or failed. Ignored in production.
RECEIPT_EXTRACTION_DEV_FIXTURE=
