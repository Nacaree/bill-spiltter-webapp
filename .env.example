# Public project coordinates are safe to expose to the browser. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-key

# Keep this server-only. Use the service-role key from the same Supabase project.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Use at least 32 random characters outside local development.
PARTICIPANT_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional previous key retained temporarily during signing-key rotation.
PARTICIPANT_SESSION_PREVIOUS_SECRET=

# Server-only Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.1-flash-lite. Model quotas depend on your project.
GEMINI_RECEIPT_MODEL=gemini-3.1-flash-lite
# Development only: success, partial, or failed. Ignored in production.
RECEIPT_EXTRACTION_DEV_FIXTURE=
